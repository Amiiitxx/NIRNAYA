# Database Configuration
# Supported: SQLite (sqlite:///./data/job_market.db) or PostgreSQL
DATABASE_URL=sqlite:///./data/job_market.db

# PostgreSQL Standard Connection Parameters
DB_NAME=job_market_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# Alternative POSTGRES_* environment variable aliases
POSTGRES_DB=job_market_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development

# Model & Data Paths
MODEL_PATH=models/salary_prediction_pipeline.joblib
CLEANED_DATA_PATH=data/processed/cleaned_job_market_all.csv
SALARY_DATA_PATH=data/processed/cleaned_salary_model_data.csv
